    "PageVisibility": {
      "additionalProperties": false,
      "description": "Optional page visibility schedule. It is a sibling of advance and is never part of screenrig.canvas/v1; it describes playback orchestration, not geometry. The server validates and carries these rules as data. The player evaluates them against the screen timezone published at the manifest root. A page is eligible when enabled is true, now is inside [from, until), and either windows is absent or at least one window matches. Every playlist must keep at least one page with no visibility field at all, so eligible content always exists. Conformance vectors for the evaluation rules are the screenrig.schedule/v1 family in packages/schedule-contract.",
      "properties": {
        "enabled": {
          "description": "False hides the page unconditionally and needs no clock. A visibility object that sets enabled true and carries no from, until, or windows is a no-op and is rejected.",
          "type": "boolean"
        },
        "from": {
          "description": "Inclusive civil lower bound in the screen timezone, minute precision, no offset and no zone suffix.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
        },
        "until": {
          "description": "Exclusive civil upper bound in the screen timezone. When both bounds are present, from must be strictly earlier than until.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/PageVisibilityWindow"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "PageVisibilityWindow": {
      "additionalProperties": false,
      "description": "One recurring civil window. Omitting start and end selects the whole day. When end is less than or equal to start the window crosses midnight and the start day owns it, so fri 22:00 to 02:00 runs into Saturday morning.",
      "properties": {
        "days": {
          "description": "Civil days of week. The server stores them in mon-to-sun order; the set carries no author-visible ordering.",
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "end": {
          "description": "Exclusive civil end time. Required when start is present.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
        },
        "start": {
          "description": "Inclusive civil start time. Required when end is present.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
        }
      },
      "required": [
        "days"
      ],
      "type": "object"
    },
